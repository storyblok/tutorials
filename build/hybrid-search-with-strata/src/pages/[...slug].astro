---
import { apiClient, StoryblokBlock, version } from '../lib/storyblok';
import Layout from '../layouts/Layout.astro';

const { slug } = Astro.params;

let story;
try {
  const { data } = await apiClient.stories.get(slug || 'home', {
    query: { version },
  });
  story = data.story;
} catch {
  return new Response(null, { status: 404 });
}
---

<Layout title={slug ? story.name : undefined}>
  <StoryblokBlock block={story.content} />
</Layout>
