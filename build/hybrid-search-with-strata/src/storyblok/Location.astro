---
import { StoryblokRichText } from '../lib/storyblok';
const { block, editable } = Astro.props;
---

<main {...editable}>
  <h1>{block.name}</h1>
  {
    block.image?.filename && (
      <img src={`${block.image.filename}/m/900x0`} alt={block.image.alt ?? ''} />
    )
  }
  <p>
    {block.street_address}, {block.city}, {block.state} {block.postal_code}
  </p>
  {block.phone && <p>{block.phone}</p>}
  {
    block.description && (
      <article>
        <StoryblokRichText document={block.description} />
      </article>
    )
  }
  {block.hours && <p style="white-space: pre-line">{block.hours}</p>}
</main>
