---
import { StoryblokRichText } from '../lib/storyblok';
import { categoryName, formatPrice } from '../lib/categories';
const { block, editable } = Astro.props;
const images: any[] = block.images ?? [];
const features: string[] = block.features?.split('\n').filter(Boolean) ?? [];
---

<main class="product" {...editable}>
  {
    block.category && (
      <a href={`/categories/${block.category}`}>
        ← {categoryName(block.category)}
      </a>
    )
  }
  <h1>{block.title}</h1>
  {block.brand && <p>{block.brand} · SKU {block.sku}</p>}
  <p class="product-price">
    {
      block.sale_price ? (
        <>
          <s>{formatPrice(block.price, block.currency)}</s>{' '}
          {formatPrice(block.sale_price, block.currency)}
        </>
      ) : (
        formatPrice(block.price, block.currency)
      )
    }
    {!block.in_stock && <span> · Out of stock</span>}
  </p>
  {
    images.length > 0 && (
      <div class="product-images">
        {images.map((image) => (
          <img
            src={`${image.filename}/m/600x0`}
            alt={image.alt ?? ''}
          />
        ))}
      </div>
    )
  }
  {block.short_description && <p>{block.short_description}</p>}
  {
    block.description && (
      <article>
        <StoryblokRichText document={block.description} />
      </article>
    )
  }
  {
    features.length > 0 && (
      <ul>
        {features.map((feature) => (
          <li>{feature}</li>
        ))}
      </ul>
    )
  }
  {block.materials && <p>Materials: {block.materials}</p>}
</main>
