---
import type { StoryblokBlockData } from '@storyblok/astro';
import { StoryblokBlock } from '../lib/storyblok';
const { block, editable } = Astro.props;
const nestedBlocks: StoryblokBlockData[] = block.columns ?? [];
---

<div class="grid" {...editable}>
  {
    nestedBlocks.map((nestedBlock) => {
      return <StoryblokBlock block={nestedBlock} />;
    })
  }
</div>
